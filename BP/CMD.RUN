* CMD.RUN — parse the sentence, dispatch to the matching handler, or print
* generated help.  ONE source for MVX and UniData: $IFDEF MVX selects the two
* host differences — the current sentence (SENTENCE() vs @SENTENCE) and the FMT
* justification mask (L#12 vs 12L).  The MVX compiler defines the MVX symbol;
* UniData does not.  We branch whole statements rather than $DEFINE macros:
* UniData's $IFDEF/$ELSE/$ENDIF is fine, but its $DEFINE does not do the value
* substitution MVX's does.
      SUBROUTINE CMD.RUN
      COMMON /CMDPKG/ CNAME, CDESC, CSUBS, CDESCS, CHANDLERS
$IFDEF MVX
      S = TRIM(SENTENCE())
      LFMT = "L#12"
$ELSE
      S = TRIM(@SENTENCE)
      LFMT = "12L"
$ENDIF
      W = FIELD(S, " ", 2)
      WU = OCONV(W, "MCU")
      IF WU = "" OR WU = "HELP" THEN
         GOSUB 9100
         RETURN
      END
      LOCATE(WU, CSUBS; POS) THEN
         H = CHANDLERS<POS>
         CALL @H
      END ELSE
         PRINT CNAME:": unknown command '":W:"'"
         GOSUB 9100
      END
      RETURN
*
* generated help
9100
      PRINT CNAME:" - ":CDESC
      PRINT "usage: ":CNAME:" <command>"
      PRINT "commands:"
      N = DCOUNT(CSUBS, @AM)
      FOR I = 1 TO N
         PRINT "  ":FMT(OCONV(CSUBS<I>, "MCL"), LFMT):" ":CDESCS<I>
      NEXT I
      PRINT "  ":FMT("help", LFMT):" show this help"
      RETURN
