* CMD.RUN — parse the sentence, dispatch to the matching handler, or print
* generated help.  ONE source for MVX and UniData: the MVX compiler defines the
* MVX preprocessor symbol (UniData does not), so $IFDEF MVX picks the MVX form
* of the two host differences — the current sentence (SENTENCE() vs @SENTENCE)
* and the FMT justification mask (L#12 vs 12L).
$IFDEF MVX
$DEFINE SENT SENTENCE()
$DEFINE LFMT "L#12"
$ELSE
$DEFINE SENT @SENTENCE
$DEFINE LFMT "12L"
$ENDIF
SUBROUTINE CMD.RUN
   COMMON /CMDPKG/ CNAME, CDESC, CSUBS, CDESCS, CHANDLERS
   S = TRIM(SENT)
   W = FIELD(S, " ", 2)
   WU = OCONV(W, "MCU")
   IF WU = "" OR WU = "HELP" THEN
      GOSUB 9100
      RETURN
   END
   LOCATE(WU, CSUBS; POS) THEN
      H = CHANDLERS<POS>
      CALL @H
   END ELSE
      PRINT CNAME:": unknown command '":W:"'"
      GOSUB 9100
   END
RETURN
*
* generated help
9100
   PRINT CNAME:" - ":CDESC
   PRINT "usage: ":CNAME:" <command>"
   PRINT "commands:"
   N = DCOUNT(CSUBS, @AM)
   FOR I = 1 TO N
      PRINT "  ":FMT(OCONV(CSUBS<I>, "MCL"), LFMT):" ":CDESCS<I>
   NEXT I
   PRINT "  ":FMT("help", LFMT):" show this help"
RETURN
